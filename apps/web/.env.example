# Copy to .env.local and fill in.

# Where apps/api answers.
NEXT_PUBLIC_API_URL="http://localhost:3001/v1"

# Error monitoring (Sentry). Empty = off, and visitors download none of its
# code. Reports go through /api/monitoring and carry the error only, never who
# caused it (src/lib/monitoring.ts).
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""

# How many proxies sit in front of this server and add to X-Forwarded-For
# (src/lib/clientIp.ts). Default 1.
WEB_TRUSTED_PROXY_HOPS=""

# Analytics script, loaded only with consent on public pages
# (components/privacy/AnalyticsLoader.tsx). Empty = none.
NEXT_PUBLIC_ANALYTICS_SRC=""

# Questions on IWT Social (off in production until the Terms are cleared).
NEXT_PUBLIC_SOCIAL_QUESTIONS_ENABLED=""
