DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iwtr?schema=public"
PORT=3001
WEB_ORIGIN="http://localhost:3000"
JWT_ACCESS_SECRET="dev-only-change-me"
PII_MASTER_KEY="dev-only-32-byte-key-change-me!!"
TCKN_HASH_PEPPER="dev-only-change-me"

# Google Sign-In (see setup steps shared in chat). Only the Client ID is
# needed — we verify the ID token's audience against it, no client secret.
GOOGLE_CLIENT_ID=""

# Apple Sign-In (requires a paid Apple Developer account + HTTPS return URL).
APPLE_SERVICES_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# iyzico (Plus-tier company subscriptions). Get these from an iyzico merchant
# account's API keys panel — sandbox keys work fine for local dev/testing.
# IYZICO_BASE_URL should be https://sandbox-api.iyzipay.com until you go live,
# then https://api.iyzipay.com.
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
# Create a subscription product + pricing plan in the iyzico panel first,
# then put its pricing plan reference code here.
IYZICO_PLUS_PRICING_PLAN_REFERENCE_CODE=""
# This API's own public address, so iyzico's checkout-form redirect can reach
# it. Localhost only works with a tunnel (e.g. ngrok) during local testing —
# in production this should be the real deployed API URL.
API_PUBLIC_URL="http://localhost:3001/v1"
