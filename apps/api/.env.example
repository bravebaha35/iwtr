DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iwtr?schema=public"
PORT=3001
WEB_ORIGIN="http://localhost:3000"
JWT_ACCESS_SECRET="dev-only-change-me"
PII_MASTER_KEY="dev-only-32-byte-key-change-me!!"
TCKN_HASH_PEPPER="dev-only-change-me"
PHONE_HASH_PEPPER="dev-only-change-me"
# Separate key from PHONE_HASH_PEPPER (that one derives a one-way lookup
# hash; this one encrypts the verified number so a user can see it back on
# their own account-settings page). A compromised value only exposes phone
# numbers, not the PII vault or the dedup hash.
PHONE_ENCRYPTION_KEY="dev-only-change-me"

# Admin-login OTP (see admin-otp.util.ts) — HMAC pepper for the 6-digit code
# the ADMIN role gets sent on every login. Own key, deliberately separate
# from PHONE_HASH_PEPPER.
ADMIN_OTP_PEPPER="dev-only-change-me"

# Law No. 5651 traffic-log (auth/register/review-submission access records).
# Own keys, deliberately separate from every other module's — see
# apps/api/src/modules/traffic-log/crypto.util.ts.
TRAFFIC_LOG_HASH_PEPPER="dev-only-change-me"
TRAFFIC_LOG_ENCRYPTION_KEY="dev-only-change-me"

# Verified-employer legal-contact profile (name/phone/address/T.C. Kimlik No —
# see EmployerProfile in schema.prisma). Own keys, deliberately separate from
# PiiVault's — see apps/api/src/modules/employer-profile/crypto.util.ts.
EMPLOYER_PII_MASTER_KEY="dev-only-change-me"
EMPLOYER_TCKN_HASH_PEPPER="dev-only-change-me"

# SMS (phone verification during onboarding). Without these set, requests fall
# back to logging the code to the API console instead of sending a real text —
# fine for local dev, but the app refuses to fake-send once NODE_ENV=production.
# Get these from a Twilio account: https://www.twilio.com/console.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Google Sign-In (see setup steps shared in chat). Only the Client ID is
# needed — we verify the ID token's audience against it, no client secret.
GOOGLE_CLIENT_ID=""

# Apple Sign-In (requires a paid Apple Developer account + HTTPS return URL).
APPLE_SERVICES_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# iyzico (Plus-tier company subscriptions). Get these from an iyzico merchant
# account's API keys panel — sandbox keys work fine for local dev/testing.
# IYZICO_BASE_URL should be https://sandbox-api.iyzipay.com until you go live,
# then https://api.iyzipay.com.
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
# Create a subscription product + pricing plan in the iyzico panel first,
# then put its pricing plan reference code here.
IYZICO_PLUS_PRICING_PLAN_REFERENCE_CODE=""
# This API's own public address, so iyzico's checkout-form redirect can reach
# it. Localhost only works with a tunnel (e.g. ngrok) during local testing —
# in production this should be the real deployed API URL.
API_PUBLIC_URL="http://localhost:3001/v1"

# Rival Analytics (Starter/Pro pay per pull; Enterprise gets one free pull —
# see decideRivalAnalyticsAccess). Price is a plain TRY amount, e.g. "499.90"
# — leave unset to keep the paid path showing "not configured yet" instead
# of starting a real charge.
RIVAL_ANALYTICS_PULL_PRICE_TRY=""
# Outbound mail for the generated PDF report. Works with any SMTP account,
# including a Google Workspace mailbox — leave unset to fall back to logging
# the email to the console instead of actually sending it (fine for local
# dev). SENDER_EMAIL overrides the "from" address; if unset, it defaults to
# whatever mailbox SMTP_USER authenticates as.
RIVAL_ANALYTICS_SMTP_HOST="smtp.gmail.com"
RIVAL_ANALYTICS_SMTP_PORT="587"
RIVAL_ANALYTICS_SMTP_USER=""
RIVAL_ANALYTICS_SMTP_PASSWORD=""
RIVAL_ANALYTICS_SENDER_EMAIL=""

# Company descriptions (apps/api/src/modules/company-narrative). When set,
# company pages show a Claude-written summary of each company's survey
# results, generated lazily on page view and cached in the CompanyNarrative
# table. Unset = feature off: no API calls, a plain numeric sentence is shown
# instead. Uses the claude-haiku-4-5 model; cost is a fraction of a cent per
# company per refresh.
ANTHROPIC_API_KEY=""
