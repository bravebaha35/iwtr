generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "pii"]
}

// ===================== public schema =====================

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE

  @@schema("public")
}

enum UserRole {
  MEMBER
  ADMIN
  COMPANY_OWNER

  @@schema("public")
}

enum UserStatus {
  PENDING_PHONE
  PENDING_PII
  PENDING_HISTORY
  PENDING_AVATAR
  ACTIVE
  SUSPENDED

  @@schema("public")
}

enum EduLevel {
  ELEMENTARY
  HIGH_SCHOOL
  COLLEGE

  @@schema("public")
}

enum OwnerTier {
  FREE
  PLUS

  @@schema("public")
}

enum PlanStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED

  @@schema("public")
}

enum ReviewStatus {
  PENDING_MODERATION
  PENDING_ADMIN_REVIEW
  PUBLISHED
  REJECTED

  @@schema("public")
}

enum QueueStatus {
  OPEN
  ASKED_FOR_SGK_DOC
  APPROVED
  REJECTED

  @@schema("public")
}

enum OwnerClaimStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("public")
}

// A deliberately small, fixed classification of the *nature* of the work
// (office/remote/service/manual-labour) — distinct from Company.category,
// which is the specific business type (e.g. "Software", "Restaurant"). This
// is what drives the browse-page sidebar filter; category does not.
enum WorkplaceType {
  OFFICE
  HYBRID_REMOTE
  SERVICE
  MANUAL_LABOUR

  @@schema("public")
}

model User {
  id              String       @id @default(uuid())
  email           String?      @unique
  authProvider    AuthProvider
  providerSubId   String?      @unique
  passwordHash    String?
  role            UserRole     @default(MEMBER)
  status          UserStatus   @default(PENDING_PHONE)
  avatarKey       String?
  // Key into the client-side gradient palette (apps/web/src/lib/avatarGradients.ts)
  // the user picked as their avatar background — loosely validated like
  // avatarKey (not a Prisma/zod enum) so the palette can grow without a
  // migration; an unrecognized key just falls back to the first gradient.
  avatarGradient  String?
  // Permanent, self-chosen anonymous handle — picked from a fixed pool of
  // ~10 humorous names per work-type category (ANONYMOUS_USERNAMES_BY_
  // WORKPLACE_TYPE in shared-types/review.ts), never free text, so there's
  // no offensive-content/identifying-name risk to moderate the way the old
  // free-typed displayName needed. Auto-assigned once at onboarding (see
  // OnboardingService.submitAvatar), changeable any time afterward from the
  // account-settings "Customize" page (ProfileService.updateProfile).
  // Deliberately NOT part of PiiVault — shown in the header AND (unlike the
  // old displayName it replaced) on the user's own published reviews (see
  // ReviewsService.listForCompany and REVIEW.md rule #8's approved-exception
  // note) — this fully replaced the old numeric memberNumber system, which
  // is why there's no separate "number" field anymore at all.
  reviewUsername  String?
  country         String?
  city            String?
  district        String?
  // HMAC of the E.164 phone number verified via OTP during onboarding — kept
  // indefinitely (like PiiVault.tcKimlikNoHash) purely to flag duplicate
  // accounts on the same phone for admin review. A collision NEVER blocks
  // registration or is surfaced to the submitter (see PhoneVerificationService)
  // — a live 409 here would be the same deanonymization oracle already fixed
  // for T.C. Kimlik No (REVIEW.md).
  phoneNumberHash String?      @unique
  // AES-256-GCM encrypted E.164 phone number (apps/api/src/modules/phone-verification/crypto.util.ts),
  // set once OTP verification succeeds — kept (unlike the OTP challenge's
  // copy, which is transient) so the account-settings page can show a user
  // their own verified number back to them. Decrypted only for that
  // self-view case, never for anything else.
  encPhoneNumber  Bytes?
  phoneVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  educationHistory   EducationHistory[]
  employmentHistory  EmploymentHistory[]
  reviews            Review[]
  reviewVotes        ReviewVote[]
  refreshTokens      RefreshToken[]
  auditLogEntries    AuditLog[]
  companyOwnerships  CompanyOwner[]
  ownerContactMessages OwnerContactMessage[]
  phoneOtpChallenge  PhoneOtpChallenge?
  // Cross-schema relation (public -> pii) — safe here specifically because
  // EmployerProfile is not an anonymity-sensitive model the way PiiVault is;
  // see EmployerProfile's own doc comment for why it gets a direct relation
  // when PiiVault deliberately doesn't.
  employerProfile    EmployerProfile?

  @@schema("public")
}

// Short-lived OTP challenge for the phone-verification onboarding step. One
// row per user (upserted on resend) — never stores the raw code, only its
// hash, so nothing guessable lingers if the row is abandoned. The phone
// number itself is kept encrypted (not just hashed) purely so a successful
// verification can copy it into User.encPhoneNumber; this row is still
// deleted once verified (or expired/exhausted and re-requested).
model PhoneOtpChallenge {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id])
  phoneNumberHash String
  encPhoneNumber  Bytes
  codeHash        String
  attempts        Int      @default(0)
  expiresAt       DateTime
  lastSentAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@schema("public")
}

model EducationHistory {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  level           EduLevel
  institutionName String
  graduationYear  Int?
  // Only ever set for level === COLLEGE — see educationHistoryInputSchema.
  faculty         String?
  department      String?
  createdAt       DateTime @default(now())

  // Unlike MySQL, Postgres does NOT automatically index a relation's scalar
  // FK column — every @@index below this comment across this file exists to
  // close that gap explicitly, since nothing here previously had one.
  @@index([userId])
  @@schema("public")
}

model EmploymentHistory {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id])
  rawCompanyName String
  // What the reviewer actually did there (e.g. "Software Engineer") —
  // free text, optional (nullable so existing rows before this column don't
  // need a backfill), never shown as part of a review's byline elsewhere;
  // it's just context on the employment entry itself.
  jobTitle       String?
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())

  reviews Review[]

  @@index([userId])
  @@index([companyId])
  @@schema("public")
}

model Company {
  id               String        @id @default(uuid())
  slug             String        @unique
  name             String
  category         String
  // Up to 2 tags — a company can genuinely span more than one kind of work
  // (e.g. a hospital is SERVICE + OFFICE), but never more than 2 (enforced
  // in shared-types/company.ts's zod schema, not at the DB layer). A
  // reviewer's own Review.workplaceType is a single value picked from this
  // set — see Review below.
  workplaceTypes   WorkplaceType[] @default([SERVICE])
  mainPhotoUrl     String?
  description      String?
  website          String?
  city             String?
  district         String?
  isVerifiedBadge  Boolean  @default(false)
  createdByAdminId String?
  createdAt        DateTime @default(now())

  // Public contact/socials, owner-editable from the "My companies" dashboard
  // (OwnerService.updateMyCompany) — free tier, not Plus-gated like
  // description/website. All nullable: most existing companies won't have
  // these filled in until an owner claims and fills them out.
  contactEmail  String?
  contactPhone  String?
  facebookUrl   String?
  instagramUrl  String?
  whatsappUrl   String?
  xUrl          String?

  employmentHistories EmploymentHistory[]
  reviews             Review[]
  owners              CompanyOwner[]
  aggregate           CompanyAggregateScore?
  ownerContactMessages OwnerContactMessage[]

  // name: helps the case-insensitive exact-match duplicate check
  // (CompaniesService.createByAdmin/updateMyCompany) and ORDER BY name — a
  // plain btree index doesn't accelerate the `contains` search itself
  // (that needs pg_trgm, a later step, not added here). city/district:
  // now real WHERE filters (CompaniesService.search), previously unindexed
  // even though city was already filterable.
  @@index([name])
  @@index([city])
  @@index([district])
  @@schema("public")
}

model CompanyOwner {
  id                    String           @id @default(uuid())
  userId                String
  user                  User             @relation(fields: [userId], references: [id])
  companyId             String
  company               Company          @relation(fields: [companyId], references: [id])
  tier                  OwnerTier        @default(FREE)
  planStatus            PlanStatus       @default(NONE)
  iyzicoSubscriptionRef String?
  planRenewsAt          DateTime?
  claimStatus           OwnerClaimStatus @default(PENDING)
  claimMessage          String?
  createdAt             DateTime         @default(now())
  resolvedAt            DateTime?

  @@unique([userId, companyId])
  @@schema("public")
}

// One-way owner -> admin channel only: an approved owner can flag something
// to the admin (e.g. "this data is wrong", "I need help"), but there is
// deliberately no reply/messaging path back to reviewers or the public here.
model OwnerContactMessage {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id])
  message    String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([companyId])
  @@schema("public")
}

model Review {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id])
  employmentHistoryId String
  employmentHistory   EmploymentHistory @relation(fields: [employmentHistoryId], references: [id])

  // Which of the company's (up to 2) workplaceTypes this specific review is
  // about — the reviewer's own role, picked at submission time and
  // immutable on edit (changing it would mean answering an entirely
  // different 25-question set, which isn't an "edit"). Must be one of
  // Company.workplaceTypes at submission time (validated in
  // ReviewsService.submitReview, never trusted from the client).
  workplaceType WorkplaceType

  // 0-5, computed server-side from surveyAnswers — never picked directly by
  // the reviewer. See ReviewsService.scoreAnswers.
  corporateCultureScore Int
  leadershipScore       Int
  infrastructureScore   Int
  workLifeBalanceScore  Int
  stabilityScore        Int
  // Raw { [questionId]: "YES" | "NO" | "PREFER_NOT_TO_ANSWER" } the reviewer
  // submitted, keyed by the stable ids in survey-questions.data.ts. Kept so
  // an edit can reload prior answers and so scores are always re-derivable.
  surveyAnswers Json
  generalThoughts String?

  status            ReviewStatus @default(PENDING_MODERATION)
  aiModerationScore Float?
  aiTrustScore      Float?
  moderationDetails Json?

  // "Randomize my avatar and username for this review" (RateButton.tsx).
  // When true, ReviewsService.listForCompany/getMyReview substitute a fixed
  // generic avatarKey/avatarGradient (RANDOMIZED_IDENTITY_AVATAR_KEY/
  // _GRADIENT in shared-types) and displayUsername for this review's own
  // avatarKey/avatarGradient/reviewUsername lookup — not stored per-row since
  // the generic avatar is a single fixed pair, always derivable from this
  // one boolean; only the flag and the randomly-picked name need to persist.
  isRandomizedIdentity Boolean @default(false)
  displayUsername      String?

  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  votes ReviewVote[]
  moderationQueueItem ModerationQueueItem?

  // The @@unique below already indexes userId as its leading column, which
  // covers userId-alone lookups (e.g. counting a reviewer's prior published
  // reviews) — but every companyId-alone lookup (listing a company's
  // reviews, recomputing its aggregate, survey stats) had nothing to use
  // until this explicit index.
  @@index([companyId])
  @@unique([userId, companyId])
  @@schema("public")
}

model ReviewVote {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  value     Int
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@schema("public")
}

model CompanyAggregateScore {
  companyId           String   @id
  company              Company @relation(fields: [companyId], references: [id])
  overallAvg           Float   @default(0)
  corporateCultureAvg  Float   @default(0)
  leadershipAvg        Float   @default(0)
  infrastructureAvg    Float   @default(0)
  workLifeBalanceAvg   Float   @default(0)
  stabilityAvg         Float   @default(0)
  reviewCount          Int     @default(0)
  updatedAt            DateTime @updatedAt

  @@schema("public")
}

model ModerationQueueItem {
  id              String      @id @default(uuid())
  reviewId        String      @unique
  review          Review      @relation(fields: [reviewId], references: [id])
  reason          String
  aiSummary       String?
  status          QueueStatus @default(OPEN)
  assignedAdminId String?
  sgkDocUrl       String?
  createdAt       DateTime    @default(now())
  resolvedAt      DateTime?

  @@schema("public")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@schema("public")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  // Looked up by this value on every single refresh (AuthService.refresh)
  // and logout — the single hottest query in this whole schema for any
  // logged-in session (refresh is reactive only, triggered by the web
  // proxy's 401 handler in apps/web/src/lib/server-auth.ts — there is no
  // proactive refresh timer) — and it had no unique constraint or index at
  // all before this. @@unique rather than a plain @@index since a collision
  // genuinely should never happen (SHA-256 of 48 random bytes).
  tokenHash   String    @unique
  deviceLabel String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@schema("public")
}

// Law No. 5651 ("Yer Sağlayıcı Yükümlülükleri") traffic-log record. Written
// automatically by TrafficLogInterceptor (apps/api/src/modules/traffic-log/)
// for a fixed allowlist of endpoints (auth register/login/google/apple,
// review submission) — never written to from anywhere else.
//
// ipAddress is reversibly encrypted (not just hashed) on purpose: the law's
// actual purpose is letting a court order trace an action back to a real IP,
// which a one-way hash can never do. ipHash is a separate non-reversible
// fingerprint kept alongside it purely for internal abuse-pattern lookups
// (e.g. "same IP hit register 20 times") without ever decrypting the real
// value. Same encrypt+hash pairing already used for TCKN/phone elsewhere in
// this schema — but with its own key/pepper (see traffic-log/crypto.util.ts),
// deliberately never the pii-vault or phone-verification ones.
//
// No Prisma relation to User, and no FK — this must survive account
// deletion (ProfileService.deleteAccount) since the retention obligation is
// independent of whether the account still exists. userId is best-effort
// context only.
//
// Retention: the law requires keeping this for a fixed window (not less than
// 1 year, not more than 2 — the exact figure is set by regulation, confirm
// with counsel before relying on a number here). No automatic purge job
// exists yet — add one once that number is confirmed.
model TrafficLog {
  id         String   @id @default(uuid())
  encIp      Bytes
  ipHash     String
  endpoint   String
  method     String
  statusCode Int?
  userId     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([ipHash])
  @@schema("public")
}

// ===================== pii schema =====================
// Deliberately isolated: only the pii-vault module ever gets a Prisma client
// pointed at this schema. No Prisma relation is declared to User — userId is
// matched by value only, so a compromise of the public schema alone cannot
// join straight through to this table.
//
// Retention policy: encTcKimlikNo is nulled out (purged) the moment the user's
// first Review reaches PUBLISHED status (AI auto-publish or admin approval).
// tcKimlikNoHash (HMAC, non-reversible) is kept indefinitely, solely to block
// duplicate accounts on the same national ID.
model PiiVault {
  userId         String    @id
  encFirstName   Bytes
  encLastName    Bytes
  encTcKimlikNo  Bytes?
  // Nullable (2026-08-02) — T.C. Kimlik No is no longer collected at
  // registration, so most rows won't have one yet. Still unique when present
  // (Postgres allows multiple NULLs under a unique constraint) so the
  // duplicate-account check still works once TCKN collection is reintroduced
  // from the account-settings page.
  tcKimlikNoHash String?   @unique
  encBirthDate   Bytes
  // Phone number is NOT stored here — it's collected and OTP-verified once,
  // earlier in onboarding (User.encPhoneNumber, via the phone-verification
  // module), and that's the single source of truth. Storing an unverified
  // second copy here would just be redundant duplicate data entry.
  dekWrapped     Bytes
  dekVersion     Int       @default(1)
  tcknPurgedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@schema("pii")
}

// Verified-employer legal-contact profile — deliberately a SEPARATE model
// from PiiVault, not a repurposing of it. PiiVault exists to prove a
// reviewer's real identity while keeping that identity uncorrelatable to
// their public activity (no Prisma relation to User, by design). An
// employer's profile is the opposite: a real person publicly and
// permanently vouching for a company they've been approved (CompanyOwner.
// claimStatus === APPROVED) to represent, so a direct User relation and
// admin-decryptable fields are the correct design here, not a bug — see
// EmployerProfileService for the "always visible to admins" access pattern
// this enables. Still lives in the isolated `pii` schema (not `public`)
// because of T.C. Kimlik No, and still uses the same envelope-encryption
// approach as PiiVault, but under its own key material (EMPLOYER_PII_
// MASTER_KEY / EMPLOYER_TCKN_HASH_PEPPER — see crypto.util.ts in the
// employer-profile module) rather than sharing PiiVault's keys, matching
// this codebase's existing "every PII-adjacent module gets its own secret"
// convention (traffic-log, phone-verification, pii-vault all do the same).
//
// Unlike PiiVault's T.C. Kimlik No, encTcKimlikNo here is never purged —
// there is no anonymity to protect for a verified public business contact,
// and the whole point of collecting it is a permanent, admin-visible legal
// record (CLAUDE.md's "employers must transition to a strictly public,
// legally verified profile" requirement) rather than a one-time fraud check.
model EmployerProfile {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id])
  // All nullable, unlike PiiVault's equivalents — this profile is filled in
  // incrementally (PATCH-style, same pattern as ProfileService.updateProfile)
  // rather than submitted all at once, so there's no single moment where
  // every field is guaranteed present. EmployerProfileService.isComplete()
  // is what actually enforces "every field present" for legal-compliance
  // purposes, not the schema.
  encFirstName    Bytes?
  encLastName     Bytes?
  encPhoneNumber  Bytes?
  encAddress      Bytes?
  encWorkAddress  Bytes?
  encTcKimlikNo   Bytes?
  // Unique when present, same duplicate-account-detection purpose as
  // PiiVault.tcKimlikNoHash — a person shouldn't be able to register as the
  // verified legal contact for multiple accounts using the same national ID.
  tcKimlikNoHash  String?  @unique
  // Company logo / employer headshot — actual upload+storage is a later
  // step (see project notes); this column just holds wherever that file
  // ends up living, exactly like Company.mainPhotoUrl already does.
  profilePictureUrl String?
  dekWrapped      Bytes
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("pii")
}
