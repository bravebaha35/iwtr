generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "pii"]
}

// ===================== public schema =====================

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE

  @@schema("public")
}

enum UserRole {
  MEMBER
  ADMIN
  COMPANY_OWNER

  @@schema("public")
}

enum UserStatus {
  PENDING_PHONE
  PENDING_PII
  PENDING_HISTORY
  PENDING_AVATAR
  ACTIVE
  SUSPENDED

  @@schema("public")
}

enum EduLevel {
  ELEMENTARY
  HIGH_SCHOOL
  COLLEGE

  @@schema("public")
}

// Resolves the "unified 4-tier pricing model" question the comment below
// used to flag as open (see project memory, 2026-09-06 decision): FREE plus
// exactly the 3 paid ranks from the CEO-finalized Free/Starter/Pro/Enterprise
// matrix (apps/web/src/lib/pricingTiers.ts), renamed here to match the badge
// each rank grants (Blue/Blue+/Enterprise — the top rank keeps the name
// "Enterprise" from that matrix, whose badge is "Gold", not a 4th name).
// tierKeyFromOwnerTier (apps/web/src/lib/pricingTiers.ts,
// apps/api/src/modules/job-postings/decideBoostAccess.ts) maps this 1:1 onto
// that matrix's free/starter/pro/enterprise keys — the matrix's own content
// (prices, feature copy) is unchanged, only the DB-backed axis driving it is
// new.
enum OwnerTier {
  FREE
  BLUE
  BLUE_PLUS
  ENTERPRISE

  @@schema("public")
}

// A deliberately separate axis from OwnerTier above — OwnerTier gates the
// existing company-listing Plus features (description/website editing,
// verified badge); this gates the new Rival Analytics add-on only. Nullable
// on CompanyOwner: unset means "no Rival Analytics subscription", which
// behaves identically to STARTER/PRO for gating purposes (always pays per
// pull) until a real self-serve upgrade flow exists — for now this is
// admin-settable only, matching how OwnerTier/planStatus are only ever set
// for real via the (also-stubbed) payments flow.
enum RivalAnalyticsTier {
  STARTER
  PRO
  ENTERPRISE

  @@schema("public")
}

enum PlanStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED

  @@schema("public")
}

enum ReviewStatus {
  PENDING_MODERATION
  PENDING_ADMIN_REVIEW
  PUBLISHED
  REJECTED

  @@schema("public")
}

enum QueueStatus {
  OPEN
  ASKED_FOR_SGK_DOC
  APPROVED
  REJECTED

  @@schema("public")
}

enum OwnerClaimStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("public")
}

enum JobPostingStatus {
  PUBLISHED
  PENDING_ADMIN
  REJECTED

  @@schema("public")
}

enum JobPostingBoostPaymentStatus {
  PENDING
  PAID

  @@schema("public")
}

// A deliberately small, fixed classification of the *nature* of the work
// (office/remote/service/manual-labour) — distinct from Company.category,
// which is the specific business type (e.g. "Software", "Restaurant"). This
// is what drives the browse-page sidebar filter; category does not.
enum WorkplaceType {
  OFFICE
  HYBRID_REMOTE
  SERVICE
  MANUAL_LABOUR

  @@schema("public")
}

// How a company's reviews are scoped to a physical location, if at all.
// SETTLED (the default, every pre-existing company): one specific address —
// city/district on Company describe that one place, same as always.
// CITY_BASED: a nationwide brand reviewed per-city (e.g. "Starbucks İstanbul
// Şubeleri") — Company.city is which city THIS row represents; a review of
// it must additionally name a district of that same city (Review.district),
// purely for context, never splitting this row's own aggregate score.
// REGION_BASED: a nationwide brand reviewed per-region (e.g. "TotalEnergies
// Marmara Bölgesi Şubeleri") — Company.region is which region THIS row
// represents; a review of it must additionally name a city within that
// region (Review.city), same non-splitting rule.
enum StructureType {
  SETTLED
  CITY_BASED
  REGION_BASED

  @@schema("public")
}

// Turkey's 7 official statistical regions (Bölge) — a coarser grouping than
// the 81 provinces in packages/shared-types/src/geo/turkey.ts, used only by
// REGION_BASED companies. Enum values are ASCII-safe identifiers; the
// Turkish display label/province list lives in shared-types (TURKEY_REGIONS)
// alongside the existing province/district data, not duplicated here.
enum TurkeyRegion {
  MARMARA
  EGE
  AKDENIZ
  IC_ANADOLU
  KARADENIZ
  DOGU_ANADOLU
  GUNEYDOGU_ANADOLU

  @@schema("public")
}

model User {
  id              String       @id @default(uuid())
  email           String?      @unique
  authProvider    AuthProvider
  providerSubId   String?      @unique
  passwordHash    String?
  role            UserRole     @default(MEMBER)
  status          UserStatus   @default(PENDING_PHONE)
  avatarKey       String?
  // Key into the client-side gradient palette (apps/web/src/lib/avatarGradients.ts)
  // the user picked as their avatar background — loosely validated like
  // avatarKey (not a Prisma/zod enum) so the palette can grow without a
  // migration; an unrecognized key just falls back to the first gradient.
  avatarGradient  String?
  // Permanent, self-chosen anonymous handle — picked from a fixed pool of
  // ~10 humorous names per work-type category (ANONYMOUS_USERNAMES_BY_
  // WORKPLACE_TYPE in shared-types/review.ts), never free text, so there's
  // no offensive-content/identifying-name risk to moderate the way the old
  // free-typed displayName needed. Auto-assigned once at onboarding (see
  // OnboardingService.submitAvatar), changeable any time afterward from the
  // account-settings "Customize" page (ProfileService.updateProfile).
  // Deliberately NOT part of PiiVault — shown in the header AND (unlike the
  // old displayName it replaced) on the user's own published reviews (see
  // ReviewsService.listForCompany and REVIEW.md rule #8's approved-exception
  // note) — this fully replaced the old numeric memberNumber system, which
  // is why there's no separate "number" field anymore at all.
  reviewUsername  String?
  country         String?
  city            String?
  district        String?
  // HMAC of the E.164 phone number verified via OTP during onboarding — kept
  // indefinitely (like PiiVault.tcKimlikNoHash) purely to flag duplicate
  // accounts on the same phone for admin review. A collision NEVER blocks
  // registration or is surfaced to the submitter (see PhoneVerificationService)
  // — a live 409 here would be the same deanonymization oracle already fixed
  // for T.C. Kimlik No (REVIEW.md).
  phoneNumberHash String?      @unique
  // AES-256-GCM encrypted E.164 phone number (apps/api/src/modules/phone-verification/crypto.util.ts),
  // set once OTP verification succeeds — kept (unlike the OTP challenge's
  // copy, which is transient) so the account-settings page can show a user
  // their own verified number back to them. Decrypted only for that
  // self-view case, never for anything else.
  encPhoneNumber  Bytes?
  phoneVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  educationHistory        EducationHistory[]
  employmentHistory       EmploymentHistory[]
  reviews                 Review[]
  reviewVotes             ReviewVote[]
  companyReplies          CompanyReply[]
  refreshTokens           RefreshToken[]
  auditLogEntries         AuditLog[]
  companyOwnerships       CompanyOwner[]
  ownerContactMessages    OwnerContactMessage[]
  phoneOtpChallenge       PhoneOtpChallenge?
  adminLoginOtpChallenges AdminLoginOtpChallenge[]
  // Cross-schema relation (public -> pii) — safe here specifically because
  // EmployerProfile is not an anonymity-sensitive model the way PiiVault is;
  // see EmployerProfile's own doc comment for why it gets a direct relation
  // when PiiVault deliberately doesn't.
  employerProfile         EmployerProfile?
  jobPostings             JobPosting[]

  @@schema("public")
}

// Short-lived OTP challenge for the phone-verification onboarding step. One
// row per user (upserted on resend) — never stores the raw code, only its
// hash, so nothing guessable lingers if the row is abandoned. The phone
// number itself is kept encrypted (not just hashed) purely so a successful
// verification can copy it into User.encPhoneNumber; this row is still
// deleted once verified (or expired/exhausted and re-requested).
model PhoneOtpChallenge {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id])
  phoneNumberHash String
  encPhoneNumber  Bytes
  codeHash        String
  attempts        Int      @default(0)
  expiresAt       DateTime
  lastSentAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@schema("public")
}

// Second-factor challenge for the admin-login OTP step (AuthService /
// AdminLoginOtpService) — deliberately its own model rather than reusing
// PhoneOtpChallenge: different lifecycle (one fresh row per login attempt,
// not upserted per-user), different secret material (its own
// ADMIN_OTP_PEPPER — see admin-otp.util.ts — so a compromised phone-OTP
// pepper can't also forge an admin login code, same isolation reasoning as
// the separate phone/PII encryption keys), and no phone number involved.
// Never stores the raw code, only its hash. Rows are deleted once
// consumed (or left to expire) — nothing here needs to outlive the login
// attempt it belongs to.
model AdminLoginOtpChallenge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("public")
}

// One admin's decision to dismiss a "pending company suggestion" — a
// worker-typed EmploymentHistory.rawCompanyName that doesn't match a real
// Company yet (companyId is null). Dismissing one of these is deliberately
// NOT a delete of anything worker-owned: every affected worker keeps their
// own employment-history entry exactly as they typed it, this just hides
// that name from the admin queue going forward (AdminCompaniesService).
// nameKey is the normalized (trimmed+lowercased) rawCompanyName so
// "A101", "a101 ", and "A101" all dismiss as the same suggestion.
model CompanySuggestionDismissal {
  id                 String   @id @default(uuid())
  nameKey            String   @unique
  dismissedByAdminId String?
  dismissedAt        DateTime @default(now())

  @@schema("public")
}

model EducationHistory {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  level           EduLevel
  institutionName String
  graduationYear  Int?
  // Only ever set for level === COLLEGE — see educationHistoryInputSchema.
  faculty         String?
  department      String?
  createdAt       DateTime @default(now())

  // Unlike MySQL, Postgres does NOT automatically index a relation's scalar
  // FK column — every @@index below this comment across this file exists to
  // close that gap explicitly, since nothing here previously had one.
  @@index([userId])
  @@schema("public")
}

model EmploymentHistory {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id])
  rawCompanyName String
  // What the reviewer actually did there (e.g. "Software Engineer") —
  // free text, optional (nullable so existing rows before this column don't
  // need a backfill), never shown as part of a review's byline elsewhere;
  // it's just context on the employment entry itself.
  jobTitle       String?
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())

  reviews Review[]

  @@index([userId])
  @@index([companyId])
  @@schema("public")
}

model Company {
  id               String          @id @default(uuid())
  slug             String          @unique
  name             String
  category         String
  // Up to 2 tags — a company can genuinely span more than one kind of work
  // (e.g. a hospital is SERVICE + OFFICE), but never more than 2 (enforced
  // in shared-types/company.ts's zod schema, not at the DB layer). A
  // reviewer's own Review.workplaceType is a single value picked from this
  // set — see Review below.
  workplaceTypes   WorkplaceType[] @default([SERVICE])
  mainPhotoUrl     String?
  description      String?
  website          String?
  city             String?
  district         String?
  isVerifiedBadge  Boolean         @default(false)
  // Denormalized copy of the approved owner's OwnerTier, kept in sync in the
  // same place isVerifiedBadge already is (PaymentsService.
  // applySubscriptionStatus) — needed alongside the boolean because the
  // public badge now has 4 distinct looks (none/Blue/Blue+/Gold), not just
  // yes/no. Never read CompanyOwner.tier directly for public display; this
  // is the public-safe copy of it.
  badgeTier        OwnerTier       @default(FREE)
  createdByAdminId String?
  createdAt        DateTime        @default(now())

  // See the StructureType/TurkeyRegion enum comments above. Admin-only
  // (AdminCompaniesService/CompaniesService.createByAdmin), same as
  // workplaceTypes — never owner-self-editable. Exactly one of
  // {city, region} is meaningful depending on structureType, enforced in
  // shared-types' adminCreateCompanyInputSchema/adminUpdateCompanyInputSchema,
  // not at the DB layer (Prisma has no portable cross-field constraint).
  structureType StructureType @default(SETTLED)
  region        TurkeyRegion?

  // Turkish trade-registry business identifier (Vergi Numarası / VKN) —
  // public business info, not personal data, so it lives here rather than
  // in the PII vault (contrast with a reviewer's own T.C. Kimlik No, which
  // is exactly the kind of personal identifier PiiVault exists to isolate).
  // Admin-only field (AdminCompaniesService), nullable since the existing
  // directory was seeded without it.
  taxNumber    String?
  // Yes/No "Chain Store" flag from the admin create/edit form — purely
  // informational for now (e.g. distinguishing "A101" the chain from one
  // specific branch); nothing yet reads this to change search/matching
  // behavior.
  isChainStore Boolean @default(false)
  // Owner-editable "we're currently hiring" toggle (My Companies dashboard,
  // free tier — same as the other owner-set fields below). Gates whether
  // this company appears on the /jobs page (CompaniesService.search's
  // includeJobTitles path) — the Jobs page reuses the exact same
  // Company/EmploymentHistory data as the rating homepage rather than a
  // separate job-listing table, so this is the only new bit of state
  // required to know "does this company want job data shown".
  isHiring     Boolean @default(false)

  // Public contact/socials, owner-editable from the "My companies" dashboard
  // (OwnerService.updateMyCompany) — free tier, not Plus-gated like
  // description/website. All nullable: most existing companies won't have
  // these filled in until an owner claims and fills them out.
  contactEmail String?
  contactPhone String?
  facebookUrl  String?
  instagramUrl String?
  whatsappUrl  String?
  xUrl         String?
  linkedinUrl  String?
  youtubeUrl   String?
  glassdoorUrl String?

  // Premium Features box (owner dashboard) — paid-tier-gated same as
  // description/website above. bannerImageUrl: a wide banner image, separate
  // from the square mainPhotoUrl logo. featuredReviewId: the one published
  // Review this owner has chosen to spotlight — matched by id only (no
  // Prisma relation), same "no relation, matched by value" pattern as
  // RivalAnalyticsPurchase/InvestorApiKey below, since a spotlighted review
  // must never gain a queryable back-reference from Review to Company beyond
  // the one it already has.
  bannerImageUrl   String?
  featuredReviewId String?

  employmentHistories  EmploymentHistory[]
  reviews              Review[]
  owners               CompanyOwner[]
  aggregate            CompanyAggregateScore?
  companyNarratives    CompanyNarrative[]
  ownerContactMessages OwnerContactMessage[]
  replies              CompanyReply[]
  jobPostings          JobPosting[]

  // name: helps the case-insensitive exact-match duplicate check
  // (CompaniesService.createByAdmin/updateMyCompany) and ORDER BY name — a
  // plain btree index doesn't accelerate the `contains` search itself
  // (that needs pg_trgm, a later step, not added here). city/district:
  // now real WHERE filters (CompaniesService.search), previously unindexed
  // even though city was already filterable.
  @@index([name])
  @@index([city])
  @@index([district])
  @@schema("public")
}

model CompanyOwner {
  id                    String           @id @default(uuid())
  userId                String
  user                  User             @relation(fields: [userId], references: [id])
  companyId             String
  company               Company          @relation(fields: [companyId], references: [id])
  tier                  OwnerTier        @default(FREE)
  // Which paid tier a just-initiated checkout is for — set right before
  // redirecting to iyzico (PaymentsService.initiatePlusCheckout), read and
  // cleared once the callback confirms payment (applySubscriptionStatus).
  // Needed because iyzico's callback only carries a token/conversationId,
  // not which of the 3 paid tiers the buyer actually picked.
  pendingTier           OwnerTier?
  planStatus            PlanStatus       @default(NONE)
  iyzicoSubscriptionRef String?
  planRenewsAt          DateTime?
  claimStatus           OwnerClaimStatus @default(PENDING)
  claimMessage          String?
  createdAt             DateTime         @default(now())
  resolvedAt            DateTime?

  // Rival Analytics add-on (see RivalAnalyticsTier above) — independent of
  // tier/planStatus above, which govern the unrelated Plus company-listing
  // features.
  rivalAnalyticsTier            RivalAnalyticsTier?
  rivalAnalyticsFreeRequestUsed Boolean             @default(false)

  @@unique([userId, companyId])
  @@schema("public")
}

// An individually-authored job posting (Employer UI overhaul) — distinct
// from Company.isHiring + the auto-classified jobTitles the /jobs page
// already derives from EmploymentHistory (see JobsBrowser.tsx's own top
// comment); this is the actual title+description an owner writes.
// boostIsFree is what makes "deduct from free boosts first" computable —
// free boosts used this month = count(createdByUserId, boostIsFree: true,
// createdAt >= start of month). Only a 7-day boost can ever be free (see
// decideBoostAccess.ts); a 14/21-day boost always goes through
// boostPaymentStatus PENDING -> PAID via the iyzico one-time-checkout flow.
model JobPosting {
  id                 String                        @id @default(uuid())
  companyId          String
  company            Company                       @relation(fields: [companyId], references: [id])
  createdByUserId    String
  createdByUser      User                          @relation(fields: [createdByUserId], references: [id])
  jobTitle           String
  description        String
  status             JobPostingStatus              @default(PUBLISHED)
  boostDurationDays  Int?
  boostIsFree        Boolean                       @default(false)
  boostPaymentStatus JobPostingBoostPaymentStatus?
  boostExpiresAt     DateTime?
  createdAt          DateTime                      @default(now())

  @@index([companyId])
  @@index([createdByUserId])
  @@schema("public")
}

// One-way owner -> admin channel only: an approved owner can flag something
// to the admin (e.g. "this data is wrong", "I need help"), but there is
// deliberately no reply/messaging path back to reviewers or the public here.
model OwnerContactMessage {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id])
  message    String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([companyId])
  @@schema("public")
}

model Review {
  id                  String            @id @default(uuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id])
  companyId           String
  company             Company           @relation(fields: [companyId], references: [id])
  employmentHistoryId String
  employmentHistory   EmploymentHistory @relation(fields: [employmentHistoryId], references: [id])

  // Which of the company's (up to 2) workplaceTypes this specific review is
  // about — the reviewer's own role, picked at submission time and
  // immutable on edit (changing it would mean answering an entirely
  // different 25-question set, which isn't an "edit"). Must be one of
  // Company.workplaceTypes at submission time (validated in
  // ReviewsService.submitReview, never trusted from the client).
  workplaceType WorkplaceType

  // 0-5, computed server-side from surveyAnswers — never picked directly by
  // the reviewer. See ReviewsService.scoreAnswers.
  corporateCultureScore Int
  leadershipScore       Int
  infrastructureScore   Int
  workLifeBalanceScore  Int
  stabilityScore        Int
  // Raw { [questionId]: "YES" | "NO" | "PREFER_NOT_TO_ANSWER" } the reviewer
  // submitted, keyed by the stable ids in survey-questions.data.ts. Kept so
  // an edit can reload prior answers and so scores are always re-derivable.
  surveyAnswers         Json
  generalThoughts       String?

  // Reviewer-supplied, review-level-only location tag for a non-SETTLED
  // parent company (see Company.structureType) — a district when reviewing a
  // CITY_BASED company, a city when reviewing a REGION_BASED one. Required
  // and validated against Company.city/region at submission (see
  // ReviewsService.resolveReviewLocation); NEVER null-vs-required for a
  // SETTLED company, which has no use for either. Deliberately excluded from
  // CompanyAggregateScore/recomputeAggregate — the parent's rating always
  // stays one unified number regardless of which district/city a review
  // names. Exposure is additionally gated at read time (see
  // ReviewsService.listForCompany's k-anonymity threshold) so a district/city
  // with too few reviews to blend in is never surfaced.
  city     String?
  district String?

  status            ReviewStatus @default(PENDING_MODERATION)
  aiModerationScore Float?
  aiTrustScore      Float?
  moderationDetails Json?

  // "Randomize my avatar and username for this review" (RateButton.tsx).
  // When true, ReviewsService.listForCompany/getMyReview substitute a fixed
  // generic avatarKey/avatarGradient (RANDOMIZED_IDENTITY_AVATAR_KEY/
  // _GRADIENT in shared-types) and displayUsername for this review's own
  // avatarKey/avatarGradient/reviewUsername lookup — not stored per-row since
  // the generic avatar is a single fixed pair, always derivable from this
  // one boolean; only the flag and the randomly-picked name need to persist.
  isRandomizedIdentity Boolean @default(false)
  displayUsername      String?

  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  votes               ReviewVote[]
  moderationQueueItem ModerationQueueItem?
  companyReply        CompanyReply?

  @@unique([userId, companyId])
  // The @@unique below already indexes userId as its leading column, which
  // covers userId-alone lookups (e.g. counting a reviewer's prior published
  // reviews) — but every companyId-alone lookup (listing a company's
  // reviews, recomputing its aggregate, survey stats) had nothing to use
  // until this explicit index.
  @@index([companyId])
  // Backs listForCompany's k-anonymity grouped counts (how many published
  // reviews share this company's exact district, and separately its exact
  // city) — both group by companyId first, same leading column as the index
  // above, so this is additive rather than redundant with it.
  @@index([companyId, district])
  @@index([companyId, city])
  @@schema("public")
}

model ReviewVote {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  value     Int
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@schema("public")
}

// A company's single public response to one of its reviews — always visible
// to everyone alongside the review, never a private message to the reviewer
// (see the "no reply/messaging path back to reviewers" note on Review above:
// a PUBLIC reply doesn't reopen that path, since the company still never
// learns who the reviewer is — it's replying to the review's content, not
// contacting a person). One reply per review (@@unique([reviewId]), not a
// thread) — checked through the same ModerationService.checkContent
// profanity/name-pattern pipeline reviews use before it's ever persisted,
// since the one real risk here is a reply trying to name or out the
// reviewer. authorUserId is kept for audit only and is never exposed on the
// public read shape (see ReviewsService.listForCompany) — a reply is
// attributed to the company, not to whichever individual owner account wrote
// it.
model CompanyReply {
  id           String   @id @default(uuid())
  reviewId     String   @unique
  review       Review   @relation(fields: [reviewId], references: [id])
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  authorUserId String
  authorUser   User     @relation(fields: [authorUserId], references: [id])
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
  @@schema("public")
}

model CompanyAggregateScore {
  companyId           String   @id
  company             Company  @relation(fields: [companyId], references: [id])
  overallAvg          Float    @default(0)
  corporateCultureAvg Float    @default(0)
  leadershipAvg       Float    @default(0)
  infrastructureAvg   Float    @default(0)
  workLifeBalanceAvg  Float    @default(0)
  stabilityAvg        Float    @default(0)
  reviewCount         Int      @default(0)
  updatedAt           DateTime @updatedAt

  @@schema("public")
}

// Lazily-generated, cached rating-narrative text for one company + work-type.
// Derived-cache style like CompanyAggregateScore: never authoritative, safe
// to delete, rebuilt on demand. Written only by CompanyNarrativeService when
// a company page is viewed and the stored copy is missing/stale (see the
// 2026-08-30 spec). One row per (company, workplaceType) — a 2-tag company
// can have two.
model CompanyNarrative {
  id               String        @id @default(uuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workplaceType    WorkplaceType
  description      String        // Postgres text; <=600 chars enforced in app code
  reviewCountAtGen Int
  model            String        // e.g. "claude-haiku-4-5" (= NARRATIVE_MODEL) — mismatch forces regen
  promptVersion    Int           // bumped in-repo when the prompt changes materially
  generatedAt      DateTime      @default(now())

  @@unique([companyId, workplaceType])
  @@index([companyId])
  @@schema("public")
}

enum SummaryPatternCategory {
  INTRO
  QNA_PRIMARY
  QNA_SECONDARY
  FLAG_FALLBACK
  CONCLUSION

  @@schema("public")
}

// Hand-authored, DB-native replacement for the old Claude-generated company
// narrative (see PatternGeneratorService / CompanyNarrativeService) — no LLM
// call, no network: the engine only ever selects and concatenates rows from
// this table. Content is maintained via apps/api/scripts/seed-summary-patterns.ts
// (delete-all + re-insert on every run — this table is 100% authored template
// content, never user data, so there's nothing to lose by resetting it).
//
// qnaKey (INTRO/QNA_PRIMARY/QNA_SECONDARY rows): "<questionId>:<AGREE|DISAGREE>",
// where questionId is the stable "<WORKPLACE_TYPE>.<category>.<n>" id from
// survey-questions.data.ts — identifies exactly which survey question, and
// which direction of employee answer, this sentence narrates. INTRO rows
// (the true-tie/no-signal opener) and CONCLUSION rows reuse this same column
// for a synthetic, non-question key instead (e.g. "MANUAL_LABOUR:INTRO" /
// "MANUAL_LABOUR:CONCLUSION") purely so they can still be looked up by
// workplaceType — see PatternGeneratorService.
//
// flagKey (FLAG_FALLBACK rows only): "<category>:<cluster>:<GREEN|RED>",
// matching one exact VibeFlag out of FlagCalculatorService's Master
// Dual-Opposite Flag Chart (workplaceType is the column below, not repeated
// in this key since — unlike qnaKey — nothing here needs to match a
// pre-existing canonical string from elsewhere).
//
// A row uses exactly one semantic key (qnaKey for everything except
// FLAG_FALLBACK, flagKey for FLAG_FALLBACK) — enforced in
// PatternGeneratorService/the seed script, not at the DB layer (Prisma has
// no portable "exactly one of" constraint).
model SummaryPattern {
  id             String                 @id @default(uuid())
  workplaceType  WorkplaceType
  category       SummaryPatternCategory
  qnaKey         String?
  flagKey        String?
  textBlock      String
  characterCount Int
  createdAt      DateTime               @default(now())

  @@index([workplaceType, category, qnaKey])
  @@index([workplaceType, category, flagKey])
  @@schema("public")
}

model ModerationQueueItem {
  id              String      @id @default(uuid())
  reviewId        String      @unique
  review          Review      @relation(fields: [reviewId], references: [id])
  reason          String
  aiSummary       String?
  status          QueueStatus @default(OPEN)
  assignedAdminId String?
  sgkDocUrl       String?
  createdAt       DateTime    @default(now())
  resolvedAt      DateTime?

  @@schema("public")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@schema("public")
}

enum RivalAnalyticsPurchaseStatus {
  PENDING
  PAID

  @@schema("public")
}

// A one-off paid pull (Starter/Pro tier, or an Enterprise member with no free
// credit left — see decideRivalAnalyticsAccess). No Prisma relation to
// Company/User, same "matched by value only" pattern as InvestorApiKey below
// — this is a transactional bookkeeping row (created PENDING right before
// redirecting to iyzico, flipped to PAID by the callback once payment is
// confirmed, which is what triggers actually building and emailing the
// report), not something either model needs a back-reference array for.
// This row's own id IS the iyzico conversationId (same correlation pattern
// PaymentsService already uses for Plus subscriptions via CompanyOwner.id)
// — iyzico echoes conversationId back on the callback's status lookup, so
// there's no need to separately track its own opaque token here.
model RivalAnalyticsPurchase {
  id                  String                       @id @default(uuid())
  requestingCompanyId String
  requestingUserId    String
  targetCompanyId     String
  status              RivalAnalyticsPurchaseStatus @default(PENDING)
  createdAt           DateTime                     @default(now())
  completedAt         DateTime?

  @@schema("public")
}

// A key issued to a paying "Market Investor API" subscriber — a third-party
// actor, not a MEMBER or a Company owner, so this deliberately has no
// relation to User. Same hash-only-at-rest pattern as RefreshToken below
// (keyHash, never the raw key) so a DB read alone can never leak a usable
// credential. Issued/revoked admin-only (see InvestorApiModule) — there is
// no self-serve signup for this tier yet.
model InvestorApiKey {
  id               String    @id @default(uuid())
  keyHash          String    @unique
  organizationName String
  contactEmail     String
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?

  @@schema("public")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  // Looked up by this value on every single refresh (AuthService.refresh)
  // and logout — the single hottest query in this whole schema for any
  // logged-in session (refresh is reactive only, triggered by the web
  // proxy's 401 handler in apps/web/src/lib/server-auth.ts — there is no
  // proactive refresh timer) — and it had no unique constraint or index at
  // all before this. @@unique rather than a plain @@index since a collision
  // genuinely should never happen (SHA-256 of 48 random bytes).
  tokenHash   String    @unique
  deviceLabel String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@schema("public")
}

// Law No. 5651 ("Yer Sağlayıcı Yükümlülükleri") traffic-log record. Written
// automatically by TrafficLogInterceptor (apps/api/src/modules/traffic-log/)
// for a fixed allowlist of endpoints (auth register/login/google/apple,
// review submission) — never written to from anywhere else.
//
// ipAddress is reversibly encrypted (not just hashed) on purpose: the law's
// actual purpose is letting a court order trace an action back to a real IP,
// which a one-way hash can never do. ipHash is a separate non-reversible
// fingerprint kept alongside it purely for internal abuse-pattern lookups
// (e.g. "same IP hit register 20 times") without ever decrypting the real
// value. Same encrypt+hash pairing already used for TCKN/phone elsewhere in
// this schema — but with its own key/pepper (see traffic-log/crypto.util.ts),
// deliberately never the pii-vault or phone-verification ones.
//
// No Prisma relation to User, and no FK — this must survive account
// deletion (ProfileService.deleteAccount) since the retention obligation is
// independent of whether the account still exists. userId is best-effort
// context only.
//
// Retention: the law requires keeping this for a fixed window (not less than
// 1 year, not more than 2 — the exact figure is set by regulation, confirm
// with counsel before relying on a number here). No automatic purge job
// exists yet — add one once that number is confirmed.
model TrafficLog {
  id         String   @id @default(uuid())
  encIp      Bytes
  ipHash     String
  endpoint   String
  method     String
  statusCode Int?
  userId     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([ipHash])
  @@schema("public")
}

// ===================== pii schema =====================
// Deliberately isolated: only the pii-vault module ever gets a Prisma client
// pointed at this schema. No Prisma relation is declared to User — userId is
// matched by value only, so a compromise of the public schema alone cannot
// join straight through to this table.
//
// Retention policy: encTcKimlikNo is nulled out (purged) the moment the user's
// first Review reaches PUBLISHED status (AI auto-publish or admin approval).
// tcKimlikNoHash (HMAC, non-reversible) is kept indefinitely, solely to block
// duplicate accounts on the same national ID.
model PiiVault {
  userId         String    @id
  encFirstName   Bytes
  encLastName    Bytes
  encTcKimlikNo  Bytes?
  // Nullable (2026-08-02) — T.C. Kimlik No is no longer collected at
  // registration, so most rows won't have one yet. Still unique when present
  // (Postgres allows multiple NULLs under a unique constraint) so the
  // duplicate-account check still works once TCKN collection is reintroduced
  // from the account-settings page.
  tcKimlikNoHash String?   @unique
  encBirthDate   Bytes
  // Phone number is NOT stored here — it's collected and OTP-verified once,
  // earlier in onboarding (User.encPhoneNumber, via the phone-verification
  // module), and that's the single source of truth. Storing an unverified
  // second copy here would just be redundant duplicate data entry.
  dekWrapped     Bytes
  dekVersion     Int       @default(1)
  tcknPurgedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@schema("pii")
}

// Verified-employer legal-contact profile — deliberately a SEPARATE model
// from PiiVault, not a repurposing of it. PiiVault exists to prove a
// reviewer's real identity while keeping that identity uncorrelatable to
// their public activity (no Prisma relation to User, by design). An
// employer's profile is the opposite: a real person publicly and
// permanently vouching for a company they've been approved (CompanyOwner.
// claimStatus === APPROVED) to represent, so a direct User relation and
// admin-decryptable fields are the correct design here, not a bug — see
// EmployerProfileService for the "always visible to admins" access pattern
// this enables. Still lives in the isolated `pii` schema (not `public`)
// because of T.C. Kimlik No, and still uses the same envelope-encryption
// approach as PiiVault, but under its own key material (EMPLOYER_PII_
// MASTER_KEY / EMPLOYER_TCKN_HASH_PEPPER — see crypto.util.ts in the
// employer-profile module) rather than sharing PiiVault's keys, matching
// this codebase's existing "every PII-adjacent module gets its own secret"
// convention (traffic-log, phone-verification, pii-vault all do the same).
//
// Unlike PiiVault's T.C. Kimlik No, encTcKimlikNo here is never purged —
// there is no anonymity to protect for a verified public business contact,
// and the whole point of collecting it is a permanent, admin-visible legal
// record (CLAUDE.md's "employers must transition to a strictly public,
// legally verified profile" requirement) rather than a one-time fraud check.
model EmployerProfile {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id])
  // All nullable, unlike PiiVault's equivalents — this profile is filled in
  // incrementally (PATCH-style, same pattern as ProfileService.updateProfile)
  // rather than submitted all at once, so there's no single moment where
  // every field is guaranteed present. EmployerProfileService.isComplete()
  // is what actually enforces "every field present" for legal-compliance
  // purposes, not the schema.
  encFirstName      Bytes?
  encLastName       Bytes?
  encPhoneNumber    Bytes?
  encAddress        Bytes?
  encWorkAddress    Bytes?
  encTcKimlikNo     Bytes?
  // Unique when present, same duplicate-account-detection purpose as
  // PiiVault.tcKimlikNoHash — a person shouldn't be able to register as the
  // verified legal contact for multiple accounts using the same national ID.
  tcKimlikNoHash    String?  @unique
  // Company logo / employer headshot — actual upload+storage is a later
  // step (see project notes); this column just holds wherever that file
  // ends up living, exactly like Company.mainPhotoUrl already does.
  profilePictureUrl String?
  dekWrapped        Bytes
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@schema("pii")
}
